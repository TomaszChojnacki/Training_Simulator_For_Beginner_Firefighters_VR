  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u201EProjekt i realizacja szkoleniowej gry symulacyjnej w wirtualnej
    rzeczywisto\u015Bci dla szkolenia pocz\u0105tkuj\u0105cych stra\u017Cak\xF3w\u201D
    to interaktywny symulator VR stworzony w Unity z my\u015Bl\u0105 o bezpiecznym
    trenowaniu podstawowych zada\u0144 stra\u017Cackich. Gracz wciela si\u0119 w
    rol\u0119 stra\u017Caka i wykonuje realistyczne czynno\u015Bci, takie jak od\u0142\u0105czenie
    pr\u0105du w hali produkcyjnej, uruchomienie ci\u015Bnienia wody w wozie stra\u017Cackim,
    przeci\u0105gni\u0119cie w\u0119\u017Ca ga\u015Bniczego czy za\u0142o\u017Cenie
    maski tlenowej. Symulator pozwala zapozna\u0107 si\u0119 z realnymi zagro\u017Ceniami,
    m.in. dymem, wysok\u0105 temperatur\u0105 czy ryzykiem zawalenia nagrzanych element\xF3w
    konstrukcji. "
  m_isRightToLeft: 0
